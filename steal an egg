            sourceLabel.Position = UDim2.fromScale(0, 0.55)
            sourceLabel.BackgroundTransparency = 1
            sourceLabel.TextColor3 = Color3.fromRGB(200, 180, 255)
            sourceLabel.TextScaled = true
            sourceLabel.Font = Enum.Font.Gotham
            sourceLabel.Text = "[" .. egg.source:upper() .. "]"
            sourceLabel.Parent = billboard

            local distLabel = Instance.new("TextLabel")
            distLabel.Size = UDim2.fromScale(1, 0.2)
            distLabel.Position = UDim2.fromScale(0, 0.8)
            distLabel.BackgroundTransparency = 1
            distLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
            distLabel.TextScaled = true
            distLabel.Font = Enum.Font.Gotham
            distLabel.Parent = billboard

            local updateConn
            updateConn = RunService.RenderStepped:Connect(function()
                if not eggESPEnabled or not egg.part or not egg.part.Parent then
                    billboard:Destroy()
                    if updateConn then updateConn:Disconnect() end
                    return
                end

                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local dist = (egg.part.Position - hrp.Position).Magnitude
                distLabel.Text = string.format("[%.0f studs]", dist)

                if dist < 50 then
                    label.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
                elseif dist < 150 then
                    label.BackgroundColor3 = Color3.fromRGB(100, 100, 0)
                else
                    label.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
                end
            end)

            table.insert(eggESPConnections, updateConn)
        end

        -- Crea ESP per tutte le uova esistenti
        for _, egg in ipairs(GetAllEggs()) do
            createESP(egg)
        end

        -- Monitora nuove uova
        local newEggConn = Workspace.DescendantAdded:Connect(function(obj)
            if not eggESPEnabled then return end
            task.wait(0.3)
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local name = obj.Name:lower()
                if name:find("egg") or name:find("uovo") or name:find("lucky block")
                or name:find("mystery") or name:find("carried") or name:find("held") then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        createESP({ object = obj, part = part, source = "world" })
                    end
                end
            end
        end)
        table.insert(eggESPConnections, newEggConn)
    else
        for _, conn in ipairs(eggESPConnections) do
            pcall(function() conn:Disconnect() end)
        end
        eggESPConnections = {}
        local folder = CoreGui:FindFirstChild("EggESP_Folder")
        if folder then folder:Destroy() end
    end
end)

