        table.insert(eggESPConnections, newEggConn)
    else
        for _, conn in ipairs(eggESPConnections) do pcall(function() conn:Disconnect() end) end
        eggESPConnections = {}
        local folder = CoreGui:FindFirstChild("EggESP_Folder")
        if folder then folder:Destroy() end
    end
