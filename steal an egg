-- BYPASS ANTI-CHEAT (CUORE DELLA V7)
--========================================================--

local bypassActive = true
local originalWalkSpeed = 16
local spoofedWalkSpeed = 16
local spoofedPlatformStand = false
local spoofedFloorMaterial = Enum.Material.Plastic

-- Hookmetamethod per spoofare le letture dell'anti-cheat
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

-- Spoofing di __index: quando l'anti-cheat legge WalkSpeed, PlatformStand o FloorMaterial,
-- restituiamo il valore ORIGINALE, non quello che abbiamo modificato.
mt.__index = newcclosure(function(self, key)
    if bypassActive and checkcaller() == false then
        -- Spoof WalkSpeed
        if key == "WalkSpeed" and self:IsA("Humanoid") then
            return originalWalkSpeed
        end
        -- Spoof PlatformStand
        if key == "PlatformStand" and self:IsA("Humanoid") then
            return false
        end
        -- Spoof FloorMaterial (per il fly)
        if key == "FloorMaterial" and self:IsA("Humanoid") then
            return Enum.Material.Plastic -- Finge di essere sempre a terra
        end
        -- Spoof AssemblyLinearVelocity (per lo speed)
        if key == "AssemblyLinearVelocity" and self:IsA("BasePart") then
            local real = oldIndex(self, key)
            -- Ritorna una velocità "normale" se siamo troppo veloci
            if real.Magnitude > 50 then
                return real.Unit * 16
            end
            return real
        end
    end
    return oldIndex(self, key)
end)

-- Neutralizza le funzioni di detection dell'anti-cheat
local function neutralizeAntiCheat()
    if not bypassActive then return end
    
    -- Cerca funzioni che contengono "WalkSpeed", "Speed", "Fly", "PlatformStand"
    -- e le sostituisce con funzioni vuote
    for _, func in ipairs(getgc(true)) do
        if typeof(func) == "function" then
            local info = debug.getinfo(func)
            if info and info.source then
                local src = info.source:lower()
                -- Cerca script di anti-cheat comuni
                if src:find("anticheat") or src:find("anti_cheat") or src:find("ac") then
                    -- Prova a disattivare la funzione
                    pcall(function()
                        debug.setconstant(func, 1, 0) -- Neutralizza il primo check
                    end)
                end
            end
        end
    end
end

-- Esegui la neutralizzazione all'avvio e periodicamente
neutralizeAntiCheat()
task.spawn(function()
    while bypassActive do
        task.wait(5)
        neutralizeAntiCheat()
    end
end)

