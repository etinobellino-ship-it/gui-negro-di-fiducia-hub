-- SEZIONE: SPEED (BYPASS SERVER AUTHORITY)
--========================================================--

makeSection("SPEED (SERVER BYPASS)", Orange)
makeSlider("Velocità (studs/s)", 50, 500, 300, function(value) eggSpeedValue = value end)

local speedBypassConnection = nil
local speedBodyVelocity = nil

makeToggle("⚡ Speed Boost+ (Anti-Reset)", false, function(state)
    eggSpeedEnabled = state
    
    if state then
        if speedBypassConnection then speedBypassConnection:Disconnect() end
        
        speedBypassConnection = RunService.RenderStepped:Connect(function()
            if not eggSpeedEnabled then return end
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if not h or not hum then return end
            
            -- Non tocchiamo MAI hum.WalkSpeed (il server lo vede sempre a 16)
            -- Usiamo BodyVelocity per il movimento fisico
            local bv = h:FindFirstChild("SpeedBypassBV")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "SpeedBypassBV"
                bv.MaxForce = Vector3.new(math.huge, 0, math.huge) -- Forza infinita
                bv.P = math.huge                              -- Risposta istantanea
                bv.Parent = h
            end
            
            local md = hum.MoveDirection
            if md.Magnitude > 0.05 then
                -- Impostiamo la velocità desiderata
                local targetVel = md.Unit * eggSpeedValue
                bv.Velocity = targetVel
                
                -- Forza anche AssemblyLinearVelocity (ma l'anti-cheat la vedrà spoofata)
                local curVel = h.AssemblyLinearVelocity
                h.AssemblyLinearVelocity = Vector3.new(targetVel.X, curVel.Y, targetVel.Z)
                
                -- Aggiorna il valore spoofato
                spoofedWalkSpeed = eggSpeedValue
            else
                bv.Velocity = Vector3.zero
                spoofedWalkSpeed = originalWalkSpeed
            end
        end)
    else
        if speedBypassConnection then speedBypassConnection:Disconnect() speedBypassConnection = nil end
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChild("HumanoidRootPart")
            if h then
                local b = h:FindFirstChild("SpeedBypassBV")
                if b then b:Destroy() end
            end
        end
        spoofedWalkSpeed = originalWalkSpeed
    end
end)

--========================================================--
-- SEZIONE: AIR WALK (BYPASS FLOOR MATERIAL)
--========================================================--

makeSection("AIR WALK (ANTI-FLY BYPASS)", Cyan)

local airWalkEnabled = false
local airWalkConnection = nil
local airWalkSpeed = 45
local airWalkVerticalSpeed = 35

makeToggle("Air Walk (Hover Bypass)", false, function(state)
    airWalkEnabled = state
    if state then
        if airWalkConnection then airWalkConnection:Disconnect() end
        airWalkConnection = RunService.Heartbeat:Connect(function()
            if not airWalkEnabled then return end
            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if not h or not hum then return end
            
            -- BodyVelocity per il volo
            local bv = h:FindFirstChild("AirWalkBV")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "AirWalkBV"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.P = math.huge
                bv.Parent = h
            end
            
            -- BodyGyro per l'orientamento
            local bg = h:FindFirstChild("AirWalkBG")
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "AirWalkBG"
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.P = 30000
                bg.D = 500
                bg.CFrame = h.CFrame
                bg.Parent = h
            end
            
            -- Impostiamo PlatformStand = true (MA lo spoofing lo nasconde)
            if not hum.PlatformStand then
                hum.PlatformStand = true
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
            end
            
            -- Spoof FloorMaterial (l'anti-cheat pensa che siamo a terra)
            spoofedFloorMaterial = Enum.Material.Plastic
            
            local md = hum.MoveDirection
            local up = UserInputService:IsKeyDown(Enum.KeyCode.Space)
            local down = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                      or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            local yVel = 0
            if up and not down then yVel = airWalkVerticalSpeed end
            if down and not up then yVel = -airWalkVerticalSpeed end
            
            bv.Velocity = Vector3.new(md.X * airWalkSpeed, yVel, md.Z * airWalkSpeed)
            
            local cam = Workspace.CurrentCamera
            if cam then
                local lf = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                if lf.Magnitude > 0.01 then
                    bg.CFrame = CFrame.lookAt(h.Position, h.Position + lf.Unit)
                end
            end
        end)
    else
        if airWalkConnection then airWalkConnection:Disconnect() airWalkConnection = nil end
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChild("HumanoidRootPart")
            if h then
                local bv = h:FindFirstChild("AirWalkBV") if bv then bv:Destroy() end
                local bg = h:FindFirstChild("AirWalkBG") if bg then bg:Destroy() end
            end
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end
        spoofedFloorMaterial = nil
    end
end)

makeSlider("Air Walk • Velocità Orizzontale", 10, 200, 45, function(v) airWalkSpeed = v end)
makeSlider("Air Walk • Velocità Verticale", 5, 120, 35, function(v) airWalkVerticalSpeed = v end)

