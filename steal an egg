makeSection("EGG SPEED", Orange)

makeSlider("Egg Speed", 100, 300, 150, function(value)
    eggSpeedValue = value
end)

makeToggle("Egg Speed Boost", false, function(state)
    eggSpeedEnabled = state
    if state then
        if eggSpeedConnection then eggSpeedConnection:Disconnect() end
        eggSpeedConnection = RunService.Heartbeat:Connect(function()
            if not eggSpeedEnabled then
                if eggSpeedConnection then eggSpeedConnection:Disconnect() end
                local c = LocalPlayer.Character
                if c then
                    local h = c:FindFirstChild("HumanoidRootPart")
                    if h then
                        local b = h:FindFirstChild("Egg_SpeedBV")
                        if b then b:Destroy() end
                    end
                end
                return
            end

            local c = LocalPlayer.Character
            if not c then return end
            local h = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            if not h or not hum then return end

            if hum.MoveDirection.Magnitude > 0 then
                local bv = h:FindFirstChild("Egg_SpeedBV")
                if not bv then
                    bv = Instance.new("BodyVelocity")
                    bv.Name = "Egg_SpeedBV"
                    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
                    bv.Parent = h
                end
                bv.Velocity = hum.MoveDirection * math.min(eggSpeedValue, 280)
            else
                local bv = h:FindFirstChild("Egg_SpeedBV")
                if bv then bv.Velocity = Vector3.zero end
            end
        end)
    else
        if eggSpeedConnection then eggSpeedConnection:Disconnect() eggSpeedConnection = nil end
        local c = LocalPlayer.Character
        if c then
            local h = c:FindFirstChild("HumanoidRootPart")
            if h then
                local b = h:FindFirstChild("Egg_SpeedBV")
                if b then b:Destroy() end
            end
        end
    end
end)

