--========================================================--
-- GET ALL EGGS (CORRETTO: include uova mondo, pen, carried, dropped, animali)
--========================================================--

local function GetAllEggs()
    local eggs = {}
    local seen = {}

    local function addEgg(obj, part, source)
        if not obj or not part or seen[obj] then return end
        seen[obj] = true
        table.insert(eggs, {
            object = obj,
            part = part,
            source = source or "world",
        })
    end

    -- 1. Uova nel mondo (Workspace, cartelle comuni)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            -- Pattern esteso: include uova, egg, uovo, lucky block, mystery, brainrot
            if name:find("egg") or name:find("uovo") or name:find("lucky block")
            or name:find("mystery") or name:find("brainrot egg") then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    addEgg(obj, part, "world")
                end
            end
        end
    end

    -- 2. Uova trasportate (carried) - cercate nella character del giocatore e degli altri
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local name = obj.Name:lower()
                    if name:find("egg") or name:find("uovo") or name:find("carried")
                    or name:find("held") then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part then
                            addEgg(obj, part, "carried")
                        end
                    end
                end
            end
        end
    end

    -- 3. Uova nel pen (recinto) del giocatore locale
    local myPlot = Workspace:FindFirstChild(LocalPlayer.Name .. "_Plot")
        or Workspace:FindFirstChild(LocalPlayer.Name .. "Plot")
        or Workspace:FindFirstChild("Plot_" .. LocalPlayer.Name)
    if myPlot then
        for _, obj in ipairs(myPlot:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local name = obj.Name:lower()
                if name:find("egg") or name:find("uovo") or name:find("pen")
                or name:find("placed") then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        addEgg(obj, part, "pen")
                    end
                end
            end
        end
    end

    -- 4. Uova droppate (dropped) - in cartelle comuni
    local eggFolders = {
        Workspace:FindFirstChild("Eggs"),
        Workspace:FindFirstChild("DroppedEggs"),
        Workspace:FindFirstChild("EggFolder"),
        Workspace:FindFirstChild("EggsFolder"),
    }
    for _, folder in ipairs(eggFolders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        addEgg(obj, part, "dropped")
                    end
                end
            end
        end
    end

    return eggs
end

--========================================================--
-- GET NEAREST EGG
--========================================================--

local function GetNearestEgg()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local eggs = GetAllEggs()
    if #eggs == 0 then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for _, egg in ipairs(eggs) do
        local dist = (egg.part.Position - hrp.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = egg
        end
    end

    return nearest, nearestDist
end

--========================================================--
-- MOVE TO EGG (con BodyVelocity)
--========================================================--

local function MoveToEgg(egg)
    if not egg or not egg.part then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local direction = (egg.part.Position - hrp.Position).Unit
    local bv = hrp:FindFirstChild("Egg_MoveBV")
    if bv then bv:Destroy() end

    bv = Instance.new("BodyVelocity")
    bv.Name = "Egg_MoveBV"
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = direction * math.min(eggSpeedValue, 250)
    bv.Parent = hrp

    task.delay(0.15, function()
        if bv and bv.Parent then bv:Destroy() end
    end)
end

--========================================================--
-- COLLECT EGG
--========================================================--

local function CollectEgg(egg)
    if not egg or not egg.part then return end

    local prompt = egg.part:FindFirstChildWhichIsA("ProximityPrompt")
    if not prompt then
        for _, desc in ipairs(egg.part:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                prompt = desc
                break
            end
        end
    end

    if prompt then
        task.wait(math.random(50, 150) / 1000)
        fireproximityprompt(prompt)
    end
end

