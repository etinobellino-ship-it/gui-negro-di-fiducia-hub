-- Rileva l'uovo trasportato (loose check per essere sicuri)
local function getCarriedEgg()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if (n:find("egg") or n:find("uovo") or n:find("carried") or n:find("held")
                or n:find("lucky")) then
                if IsRealEgg(obj, obj.Name) then return obj end
            end
        end
    end
    -- Fallback: cerca tag/attributi sul character
    if char:GetAttribute("Carrying") or char:FindFirstChild("Carrying") then
        -- Ritorno un oggetto fittizio, tanto serve solo per sapere che sta portando qualcosa
        return char
    end
    return nil
end

-- Trova il plot del giocatore (multi-strategia, cachato)
local function findMyPlot()
    -- 1) Nomi diretti
    local names = {
        LocalPlayer.Name .. "_Plot",
        LocalPlayer.Name .. "Plot",
        "Plot_" .. LocalPlayer.Name,
        LocalPlayer.Name .. "'s Plot",
        LocalPlayer.Name .. "sPlot",
        LocalPlayer.DisplayName .. "_Plot",
        LocalPlayer.DisplayName .. "Plot",
    }
    for _, n in ipairs(names) do
        local p = Workspace:FindFirstChild(n)
        if p then
            local part = p:IsA("BasePart") and p or p:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position, p end
        end
    end
    -- 2) Cartelle note
    for _, folderName in ipairs({"Plots","PlotFolder","PlayerPlots","Bases","PlotsFolder"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, plot in ipairs(folder:GetChildren()) do
                local pn = plot.Name:lower():gsub("[%W_]", "")
                local ln = LocalPlayer.Name:lower():gsub("[%W_]", "")
                if pn:find(ln) or ln:find(pn) then
                    local part = plot:IsA("BasePart") and plot or plot:FindFirstChildWhichIsA("BasePart", true)
                    if part then return part.Position, plot end
                end
            end
        end
    end
    -- 3) Owner attribute / ObjectValue
    for _, obj in ipairs(Workspace:GetChildren()) do
        local owner = obj:FindFirstChild("Owner") or obj:FindFirstChild("owner")
        if owner then
            local val = owner.Value or owner
            if val == LocalPlayer
               or (typeof(val) == "string" and val == LocalPlayer.Name) then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if part then return part.Position, obj end
            end
        end
        local oa = obj:GetAttribute("Owner")
        if oa == LocalPlayer.Name or oa == LocalPlayer.UserId then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position, obj end
        end
    end
    return nil, nil
end

local function stopAutoCarryPhysics()
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart")
    if h then
        for _, n in ipairs({"AutoCarryBV","AutoCarryBG"}) do
            local o = h:FindFirstChild(n) if o then o:Destroy() end
        end
    end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function autoCarryLoop()
    if not autoCarryEnabled then return end

    local egg = getCarriedEgg()
    if not egg then
        if autoCarryState ~= "idle" then
            stopAutoCarryPhysics()
            autoCarryState = "idle"
            autoCarryTargetY = nil
            autoCarryLastPos = nil
        end
        updateCarryHUD("AUTO CARRY: in attesa dell'uovo...")
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Cache plot (ricontrolla ogni 2 secondi)
    if not autoCarryCachedPlot or (os.clock() - autoCarryCacheTime) > 2 then
        local pos, obj = findMyPlot()
        if pos then autoCarryCachedPlot = {pos = pos, obj = obj} end
        autoCarryCacheTime = os.clock()
    end
    if not autoCarryCachedPlot then
        updateCarryHUD("AUTO CARRY: plot non trovato!")
        return
    end
    local plotPos = autoCarryCachedPlot.pos

    -- Init
    if autoCarryState == "idle" then
        autoCarryState = "ascend"
        autoCarryTargetY = hrp.Position.Y + autoCarryExtraHeight + 25
        autoCarryLastPos = hrp.Position
        autoCarryStuck = 0
        hum.PlatformStand = true
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    end

    -- BodyVelocity + BodyGyro
    local bv = hrp:FindFirstChild("AutoCarryBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "AutoCarryBV"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.P = 50000
        bv.Parent = hrp
    end
    local bg = hrp:FindFirstChild("AutoCarryBG")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "AutoCarryBG"
        bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
        bg.P = 30000; bg.D = 500
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp
    end

    local curPos = hrp.Position
    local horizDelta = Vector3.new(plotPos.X - curPos.X, 0, plotPos.Z - curPos.Z)
    local horizDist = horizDelta.Magnitude
    local vel = Vector3.zero

    -- ============ STATE MACHINE ============
    if autoCarryState == "ascend" then
        if curPos.Y >= autoCarryTargetY then
            autoCarryState = "cruise"
            autoCarryLastPos = curPos
            autoCarryStuck = 0
        else
            vel = Vector3.new(0, autoCarryClimbSpeed, 0)
        end
    end

    if autoCarryState == "cruise" then
        local moved = (curPos - (autoCarryLastPos or curPos)).Magnitude
        if moved < 0.6 then autoCarryStuck = autoCarryStuck + (1/60)
        else autoCarryStuck = 0 end
        autoCarryLastPos = curPos

        if autoCarryStuck > 0.5 then
            -- Muro rilevato: risali e poi riprendi l'orizzontale
            autoCarryState = "ascend"
            autoCarryTargetY = curPos.Y + autoCarryExtraHeight
            autoCarryStuck = 0
        elseif horizDist <= 7 then
            autoCarryState = "descend"
        else
            vel = horizDelta.Unit * autoCarrySpeed
        end
    end

    if autoCarryState == "descend" then
        if curPos.Y <= plotPos.Y + 5 then
            autoCarryState = "done"
            vel = Vector3.zero
        else
            vel = Vector3.new(0, -autoCarryClimbSpeed, 0)
        end
    end

    if autoCarryState == "done" then
        bv.Velocity = Vector3.zero
        stopAutoCarryPhysics()
        autoCarryState = "idle"
        autoCarryTargetY = nil
        updateCarryHUD("AUTO CARRY: ✔ arrivato al plot!")
        return
    end

    bv.Velocity = vel
    if horizDelta.Magnitude > 0.5 and autoCarryState == "cruise" then
        bg.CFrame = CFrame.lookAt(curPos, curPos + horizDelta.Unit)
    end

    updateCarryHUD(string.format("AUTO CARRY [%s] • Dist: %.0f", autoCarryState, horizDist))
end

