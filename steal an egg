-- LOGICA EGG
--========================================================--
local eggESPEnabled = false
local eggAutoCollectEnabled = false
local eggSpeedEnabled = false
local eggNotifierEnabled = false
local eggSpeedValue = 300
local minRarityScore = 2

local eggESPConnections = {}
local eggAutoCollectConnection = nil
local eggNotifierConnection = nil
local eggSpeedConnection = nil

local function GetEggRarityScore(name)
    local n = name:lower()
    local score = 0
    if n:find("basic") or n:find("common") or n:find("starter") or n:find("bronze") then score = 0
    elseif n:find("uncommon") or n:find("silver") then score = 1
    elseif n:find("rare") or n:find("gold") then score = 2
    elseif n:find("epic") or n:find("platinum") then score = 3
    elseif n:find("legendary") or n:find("diamond") then score = 4
    elseif n:find("mythic") or n:find("divine") or n:find("secret")
        or n:find("brainrot god") or n:find("godspeed") or n:find("godly") then score = 5
    end
    return score
end

local EXCLUDE_KEYWORDS = {
    "treadmill","tread mill","machine","guard","pet","plot","base","drop pad",
    "spawner","cage","portal","teleporter","platform","conveyor","belt","wall",
    "floor","spawn","sign","button","lever","door","gate","chest","shop","npc",
    "dummy","target","orb","beam","effect","particle",
}
local function IsRealEgg(obj, name)
    local n = name:lower()
    for _, kw in ipairs(EXCLUDE_KEYWORDS) do
        if n:find(kw) then return false end
    end
    if not (n:find("egg") or n:find("uovo") or n:find("lucky block")
        or n:find("mystery") or n:find("brainrot egg")) then return false end
    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if not part then return false end
    if obj:IsA("Model") then
        if part.Anchored and not n:find("egg") then return false end
    end
    return true
end

local function GetAllEggs()
    local eggs, seen = {}, {}
    local function addEgg(obj, part, source)
        if not obj or not part or seen[obj] then return end
        seen[obj] = true
        table.insert(eggs, {object = obj, part = part, source = source or "world",
            rarityScore = GetEggRarityScore(obj.Name)})
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            if IsRealEgg(obj, obj.Name) then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then addEgg(obj, part, "world") end
            end
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local name = obj.Name:lower()
                    if (name:find("egg") or name:find("uovo") or name:find("carried")
                        or name:find("held")) and IsRealEgg(obj, obj.Name) then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part then addEgg(obj, part, "carried") end
                    end
                end
            end
        end
    end
    local myPlot = Workspace:FindFirstChild(LocalPlayer.Name .. "_Plot")
        or Workspace:FindFirstChild(LocalPlayer.Name .. "Plot")
        or Workspace:FindFirstChild("Plot_" .. LocalPlayer.Name)
    if myPlot then
        for _, obj in ipairs(myPlot:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                if IsRealEgg(obj, obj.Name) then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part then addEgg(obj, part, "pen") end
                end
            end
        end
    end
    local folders = {Workspace:FindFirstChild("Eggs"), Workspace:FindFirstChild("DroppedEggs"),
        Workspace:FindFirstChild("EggFolder"), Workspace:FindFirstChild("EggsFolder")}
    for _, folder in ipairs(folders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    if IsRealEgg(obj, obj.Name) then
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part then addEgg(obj, part, "dropped") end
                    end
                end
            end
        end
    end
    local filtered = {}
    for _, egg in ipairs(eggs) do
        if egg.rarityScore >= minRarityScore then table.insert(filtered, egg) end
    end
    return filtered
end

local function GetNearestEgg()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local eggs = GetAllEggs()
    if #eggs == 0 then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, egg in ipairs(eggs) do
        local d = (egg.part.Position - hrp.Position).Magnitude
        if d < nearestDist then nearestDist = d; nearest = egg end
    end
    return nearest, nearestDist
end

local function MoveToEgg(egg)
    if not egg or not egg.part then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dir = (egg.part.Position - hrp.Position).Unit
    local bv = hrp:FindFirstChild("Egg_MoveBV")
    if bv then bv:Destroy() end
    bv = Instance.new("BodyVelocity")
    bv.Name = "Egg_MoveBV"
    bv.MaxForce = Vector3.new(1e9, 0, 1e9)
    bv.P = 1e9
    bv.Velocity = dir * eggSpeedValue
    bv.Parent = hrp
    task.delay(0.2, function() if bv and bv.Parent then bv:Destroy() end end)
end

local function CollectEgg(egg)
    if not egg or not egg.part then return end
    local prompt = egg.part:FindFirstChildWhichIsA("ProximityPrompt")
    if not prompt then
        for _, desc in ipairs(egg.part:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then prompt = desc; break end
        end
    end
    if prompt then
        task.wait(math.random(50, 150) / 1000)
        pcall(function() fireproximityprompt(prompt) end)
    end
end

