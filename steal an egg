            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    end
    hideAirHint()
end

local function startAirWalk()
    airWalkEnabled = true
    showAirHint()
    if airWalkConnection then airWalkConnection:Disconnect() end
    airWalkConnection = RunService.Heartbeat:Connect(function()
        if not airWalkEnabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not h or not hum then return end
        local bv = h:FindFirstChild("AirWalkBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "AirWalkBV"
            bv.MaxForce = Vector3.new(4e5, 4e5, 4e5)
            bv.P = 10000
            bv.Parent = h
        end
        local bg = h:FindFirstChild("AirWalkBG")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "AirWalkBG"
            bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
            bg.P = 30000; bg.D = 500
            bg.CFrame = h.CFrame
            bg.Parent = h
        end
        if not hum.PlatformStand then
            hum.PlatformStand = true
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
        end
        local md = hum.MoveDirection
        local up = UserInputService:IsKeyDown(Enum.KeyCode.Space)
        local down = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                  or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        local yVel = 0
        if up and not down then yVel = airWalkVerticalSpeed end
        if down and not up then yVel = -airWalkVerticalSpeed end
        bv.Velocity = Vector3.new(md.X * airWalkSpeed, yVel, md.Z * airWalkSpeed)
        local cam = Workspace.CurrentCamera
        if cam then
            local lf = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            if lf.Magnitude > 0.01 then
                bg.CFrame = CFrame.lookAt(h.Position, h.Position + lf.Unit)
            end
        end
    end)
end

