    local tg = Instance.new("Frame")
    tg.AnchorPoint = Vector2.new(1, 0.5)
    tg.Position = UDim2.fromScale(0.96, 0.5)
    tg.Size = UDim2.fromOffset(46, 24)
    tg.BackgroundColor3 = default and Green or Color3.fromRGB(55, 55, 75)
    tg.BorderSizePixel = 0
    tg.ZIndex = 117
    tg.Parent = row
    Instance.new("UICorner", tg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = White
    knob.BorderSizePixel = 0
    knob.ZIndex = 118
    knob.Parent = tg
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = default
    local function toggle()
        state = not state
        if state then
            Tween(tg, 0.2, {BackgroundColor3 = Green})
            Tween(knob, 0.2, {Position = UDim2.new(1, -21, 0.5, -9)})
        else
            Tween(tg, 0.2, {BackgroundColor3 = Color3.fromRGB(55, 55, 75)})
            Tween(knob, 0.2, {Position = UDim2.new(0, 3, 0.5, -9)})
        end
        if callback then callback(state) end
    end
    tg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then toggle() end
    end)
    row.MouseEnter:Connect(function()
        Tween(row, 0.15, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
    end)
    row.MouseLeave:Connect(function()
        Tween(row, 0.15, {BackgroundColor3 = Color3.fromRGB(22, 22, 36)})
    end)
    return row
end

