    local bg = Instance.new("Frame")
    bg.Position = UDim2.fromScale(0.04, 0.68)
    bg.Size = UDim2.fromScale(0.92, 0.16)
    bg.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    bg.BorderSizePixel = 0
    bg.ZIndex = 117
    bg.Parent = row

    local bgc = Instance.new("UICorner")
    bgc.CornerRadius = UDim.new(1, 0)
    bgc.Parent = bg

    local pct = (defaultV - minV) / (maxV - minV)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(pct, 1)
    fill.BackgroundColor3 = Purple
    fill.BorderSizePixel = 0
    fill.ZIndex = 118
    fill.Parent = bg

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local fg = Instance.new("UIGradient")
    fg.Color = ColorSequence.new(Purple, Cyan)
    fg.Parent = fill

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(pct, 0, 0.5, 0)
    knob.Size = UDim2.fromOffset(16, 16)
    knob.BackgroundColor3 = White
    knob.BorderSizePixel = 0
    knob.ZIndex = 119
    knob.Parent = bg

    local knc = Instance.new("UICorner")
    knc.CornerRadius = UDim.new(1, 0)
    knc.Parent = knob

    local dragging = false
    local value = defaultV

    local function update(inputX)
        local absPos = bg.AbsolutePosition.X
        local absSize = bg.AbsoluteSize.X
        local p = math.clamp((inputX - absPos) / absSize, 0, 1)
        value = minV + (maxV - minV) * p
        fill.Size = UDim2.fromScale(p, 1)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        valLbl.Text = string.format("%.1f", value)
        if callback then callback(value) end
    end

    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(UserInputService:GetMouseLocation().X)
        end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            update(UserInputService:GetMouseLocation().X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return row
end

