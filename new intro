    -- Stato Auto Parry
    local autoParryActive = false
    local ballConnection = nil
    local lastParry = 0
    local PARry_COOLDOWN = 1
    local PARry_THRESHOLD = 0.55 -- secondi di tempo di impatto per parry

    local function getRealBall()
        for _, Ball in ipairs(workspace:GetChildren()) do
            if Ball.Name == "Balls" then
                for _, b in ipairs(Ball:GetChildren()) do
                    if b:IsA("BasePart") and b:GetAttribute("realBall") then
                        return b
                    end
                end
            end
        end
        return nil
    end

    local function parry()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        if remotes then
            local parryRemote = remotes:FindFirstChild("ParryButtonPress")
            if parryRemote then
                parryRemote:Fire()
                return true
            end
        end
        -- Fallback: simula click sinistro
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        return true
    end

    local function startAutoParry()
        if ballConnection then ballConnection:Disconnect() end

        ballConnection = RunService.Heartbeat:Connect(function()
            if not autoParryActive then return end
            if tick() - lastParry < PARry_COOLDOWN then return end

            local player = Players.LocalPlayer
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local ball = getRealBall()
            if not ball then return end

            -- Controlla se la palla ci sta puntando
            local target = ball:GetAttribute("target")
            if target ~= player.Name then return end

            -- Calcola tempo di impatto
            local distance = (hrp.Position - ball.Position).Magnitude
            local zoomies = ball:FindFirstChild("zoomies")
            if not zoomies then return end
            local vel = zoomies:FindFirstChild("VectorVelocity")
            if not vel then return end
            local speed = vel.Value.Magnitude
            if speed < 1 then return end

            local timeToImpact = distance / speed

            if timeToImpact <= PARry_THRESHOLD then
                parry()
                lastParry = tick()
            end
        end)
    end

    local function stopAutoParry()
        if ballConnection then
            ballConnection:Disconnect()
            ballConnection = nil
        end
    end

    local function toggleAutoParry()
        autoParryActive = not autoParryActive
        if autoParryActive then
            Tween(apToggle, 0.2, {BackgroundColor3 = Green})
            Tween(apKnob, 0.2, {Position = UDim2.new(1, -21, 0.5, -9)})
            startAutoParry()
        else
            Tween(apToggle, 0.2, {BackgroundColor3 = Color3.fromRGB(55, 55, 75)})
            Tween(apKnob, 0.2, {Position = UDim2.new(0, 3, 0.5, -9)})
            stopAutoParry()
        end
    end

    apToggle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then toggleAutoParry() end
    end)

    apRow.MouseEnter:Connect(function()
        Tween(apRow, 0.15, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
    end)
    apRow.MouseLeave:Connect(function()
