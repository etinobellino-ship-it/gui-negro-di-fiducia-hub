reopen.Font = Enum.Font.GothamBlack
reopen.AutoButtonColor = false
reopen.Visible = false
reopen.ZIndex = 300
reopen.Parent = gui

local reopenCorner = Instance.new("UICorner")
reopenCorner.CornerRadius = UDim.new(1, 0)
reopenCorner.Parent = reopen

local reopenStroke = Instance.new("UIStroke")
reopenStroke.Thickness = 2
reopenStroke.Parent = reopen

--========================================================--
-- DRAG & DROP
--========================================================--

local dragging = false
local dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = hub.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        hub.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

--========================================================--
-- RGB CONTINUO
--========================================================--

task.spawn(function()
    while gui.Parent do
        local t = os.clock()
        hubStroke.Color = Color3.fromHSV((t * 0.08) % 1, 0.9, 1)
        reopenStroke.Color = Color3.fromHSV((t * 0.15) % 1, 0.9, 1)
        hubTitleGradient.Offset = Vector2.new(math.sin(t * 0.8) * 0.5, 0)
        task.wait()
    end
end)

--========================================================--
-- HUB ENTRATA
--========================================================--

Tween(hub, 0.75, {
    Size = UDim2.fromScale(0.68, 0.68)
}, Enum.EasingStyle.Back)

--========================================================--
-- CLOSE / OPEN
--========================================================--

local function closeHub()
    local t = Tween(hub, 0.4, {
        Size = UDim2.fromScale(0.01, 0.01)
    }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    t.Completed:Wait()
    hub.Visible = false
    reopen.Visible = true
    reopen.Size = UDim2.fromOffset(0, 0)
    Tween(reopen, 0.4, {
        Size = UDim2.fromOffset(58, 58)
    }, Enum.EasingStyle.Back)
end

local function openHub()
    Tween(reopen, 0.25, {
        Size = UDim2.fromOffset(0, 0)
    }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    task.wait(0.25)
    reopen.Visible = false
    hub.Visible = true
    hub.Size = UDim2.fromScale(0.01, 0.01)
    Tween(hub, 0.6, {
        Size = UDim2.fromScale(0.68, 0.68)
    }, Enum.EasingStyle.Back)
end

close.MouseButton1Click:Connect(closeHub)
reopen.MouseButton1Click:Connect(openHub)

-- Minimize = come close ma resta il cerchio
minimize.MouseButton1Click:Connect(closeHub)

-- Hover X
close.MouseEnter:Connect(function()
    Tween(close, 0.15, {
        BackgroundColor3 = Color3.fromRGB(255, 25, 50),
        Size = UDim2.fromScale(0.085, 0.65)
    })
end)
close.MouseLeave:Connect(function()
    Tween(close, 0.15, {
        BackgroundColor3 = Red,
        Size = UDim2.fromScale(0.075, 0.58)
    })
end)

--========================================================--
-- KEYBIND N
--========================================================--

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.N then
        if hub.Visible then
            closeHub()
        else
            openHub()
        end
    end
end)

