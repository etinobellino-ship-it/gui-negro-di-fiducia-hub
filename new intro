        glow.Size = UDim2.fromScale(
            0.7 + math.sin(t * 2) * 0.05,
            0.4 + math.sin(t * 2) * 0.03
        )

        -- Rotazione orbita
        local angle = (t * 1.5) % (math.pi * 2)
        orbitDot.Position = UDim2.new(
            0.5 + math.cos(angle) * 0.5, 0,
            0.5 + math.sin(angle) * 0.5, 0
        )

        task.wait()
    end
end)

