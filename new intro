    makeToggleGlobal(bbContent, "Auto Parry", false, function(state)
        autoParryActive = state

        local Player = Players.LocalPlayer
        local Balls = workspace:FindFirstChild("Balls")
        local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not Balls or not Remotes then return end

        local function VerifyBall(Ball)
            return typeof(Ball) == "Instance" and Ball:IsA("BasePart")
                and Ball:IsDescendantOf(Balls)
                and Ball:GetAttribute("realBall") == true
        end

        local function IsTarget(Ball)
            return Ball:GetAttribute("target") == Player.Name
        end

        local function Parry()
            local parryRemote = Remotes:FindFirstChild("ParryButtonPress")
            if parryRemote then
                parryRemote:Fire()
            end
        end

        if state then
            if ballConnection then ballConnection:Disconnect() end
            ballConnection = Balls.ChildAdded:Connect(function(Ball)
                if not VerifyBall(Ball) then return end
                IsParried = false

                local posConnection
                posConnection = Ball:GetPropertyChangedSignal("Position"):Connect(function()
                    if not autoParryActive then return end
                    if IsParried then return end
                    if tick() - Cooldown < 0.5 then return end

                    if IsTarget(Ball) then
                        local char = Player.Character
                        if not char then return end
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hrp then return end

                        local zoomies = Ball:FindFirstChild("zoomies")
                        if not zoomies then return end
                        local velocityPart = zoomies:FindFirstChild("VectorVelocity")
                        if not velocityPart then return end

                        local speed = velocityPart.Value.Magnitude
                        if speed < 1 then return end

                        local distance = (hrp.Position - Ball.Position).Magnitude
                        local timeToImpact = distance / speed

                        if timeToImpact <= 0.55 then
                            Parry()
                            IsParried = true
                            Cooldown = tick()
                        end
                    end
                end)

                Ball.Destroying:Connect(function()
                    if posConnection then posConnection:Disconnect() end
                end)
            end)
        else
            if ballConnection then
                ballConnection:Disconnect()
                ballConnection = nil
            end
        end
    end)

    local dragging = false
    local dragStart, startPos
    bbHeader.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = bbFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            bbFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    bbFrame.Size = UDim2.fromScale(0.01, 0.01)
    Tween(bbFrame, 0.6, {Size = UDim2.fromScale(0.45, 0.55)}, Enum.EasingStyle.Back)
end

