local pages = {}

local function createPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Purple
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.ZIndex = 115
    page.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    pages[name] = page
    return page
end

local homePage  = createPage("Home")
local gamesPage = createPage("Giochi")

local function showPage(name)
    for n, p in pairs(pages) do
        p.Visible = (n == name)
    end
end

local sidebarButtons = {}
local activeBtn

local function createSidebarButton(name, icon, pageName)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 38)
    b.BackgroundColor3 = Color3.fromRGB(18, 18, 32)
    b.BorderSizePixel = 0
    b.Text = ""
    b.AutoButtonColor = false
    b.ZIndex = 115
    b.Parent = sidebar

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 8)
    bc.Parent = b

    local ic = Instance.new("TextLabel")
    ic.Position = UDim2.fromScale(0.06, 0)
    ic.Size = UDim2.fromScale(0.22, 1)
    ic.BackgroundTransparency = 1
    ic.Text = icon
    ic.TextColor3 = Cyan
    ic.TextScaled = true
    ic.Font = Enum.Font.GothamBold
    ic.ZIndex = 116
    ic.Parent = b

    local lbl = Instance.new("TextLabel")
    lbl.Position = UDim2.fromScale(0.32, 0)
    lbl.Size = UDim2.fromScale(0.65, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = name
    lbl.TextColor3 = White
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 116
    lbl.Parent = b

    local function setActive(active)
        if active then
            Tween(b, 0.15, {BackgroundColor3 = Color3.fromRGB(70, 30, 150)})
        else
            Tween(b, 0.15, {BackgroundColor3 = Color3.fromRGB(18, 18, 32)})
        end
    end

    b.MouseEnter:Connect(function()
        if activeBtn ~= b then
            Tween(b, 0.15, {BackgroundColor3 = Color3.fromRGB(30, 30, 50)})
        end
    end)
    b.MouseLeave:Connect(function()
        if activeBtn ~= b then
            Tween(b, 0.15, {BackgroundColor3 = Color3.fromRGB(18, 18, 32)})
        end
    end)

    b.MouseButton1Click:Connect(function()
        if activeBtn then
            local prev = sidebarButtons[activeBtn]
            if prev then prev(false) end
        end
        activeBtn = b
        setActive(true)
        showPage(pageName)
    end)

    sidebarButtons[b] = setActive
    return b
end

