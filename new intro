    local function GetAllEggs()
        local eggs = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local name = obj.Name:lower()
                if name:find("egg") or name:find("uovo") or name:find("lucky block") then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        table.insert(eggs, { object = obj, part = part })
                    end
                end
            end
        end
        return eggs
    end

    local function GetNearestEgg()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end

        local eggs = GetAllEggs()
        if #eggs == 0 then return nil end

        local nearest = nil
        local nearestDist = math.huge

        for _, egg in ipairs(eggs) do
            local dist = (egg.part.Position - hrp.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = egg
            end
        end

        return nearest, nearestDist
    end

    local function MoveToEgg(egg)
        if not egg or not egg.part then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local direction = (egg.part.Position - hrp.Position).Unit
        local bv = hrp:FindFirstChild("Egg_MoveBV")
        if bv then bv:Destroy() end

        bv = Instance.new("BodyVelocity")
        bv.Name = "Egg_MoveBV"
        bv.MaxForce = Vector3.new(1e5, 0, 1e5)
        bv.Velocity = direction * math.min(eggSpeedValue, 250)
        bv.Parent = hrp

        task.delay(0.15, function()
            if bv and bv.Parent then bv:Destroy() end
        end)
    end

    local function CollectEgg(egg)
        if not egg or not egg.part then return end
        local prompt = egg.part:FindFirstChildWhichIsA("ProximityPrompt")
        if not prompt then
            for _, desc in ipairs(egg.part:GetDescendants()) do
                if desc:IsA("ProximityPrompt") then
                    prompt = desc
                    break
                end
            end
        end
        if prompt then
            task.wait(math.random(50, 150) / 1000)
            fireproximityprompt(prompt)
        end
    end

