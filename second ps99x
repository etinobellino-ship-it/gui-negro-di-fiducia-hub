-- ===================== LOGICA ====================

-- Loop Auto-Walk (cammina verso ogni posizione salvata, salta se bloccato)
task.spawn(function()
    while true do
        if autoWalk and #positions >= 1 then
            if cycleIndex > #positions then cycleIndex = 1 end
            local target = positions[cycleIndex]

            walkTo(target)          -- attende fino ad arrivo o timeout
            task.wait(delayTime)    -- pausa extra dopo l'arrivo

            cycleIndex = cycleIndex + 1
            if cycleIndex > #positions then cycleIndex = 1 end
        else
            task.wait(0.2)
        end
    end
end)

-- Rileva ProximityPrompt
ProximityPromptService.PromptShown:Connect(function(prompt)
    currentPrompt = prompt
end)

ProximityPromptService.PromptHidden:Connect(function(prompt)
    if currentPrompt == prompt then
        currentPrompt = nil
    end
end)

-- Loop Auto-Press E
task.spawn(function()
    while true do
        if autoE then
            if currentPrompt then
                if fireproximityprompt then
                    pcall(fireproximityprompt, currentPrompt)
                end
            end
            pcall(function()
                VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)
            task.wait(0.1)
        else
            task.wait(0.2)
        end
    end
end)

