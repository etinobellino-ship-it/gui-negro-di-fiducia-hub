-- ===================== HELPERS ===================
local function getChar()
    return LP.Character
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- Fa saltare il personaggio una volta
local function doJump()
    local hum = getHum()
    if not hum then return end
    pcall(function()
        hum.Jump = true
    end)
    -- fallback: simula spazio
    pcall(function()
        VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

-- Cammina verso vec3 (NON teletrasporta).
-- Salta automaticamente se rileva di essere bloccato.
-- Ritorna true se arrivato.
local function walkTo(vec3)
    local char = getChar()
    if not char then return false end
    local hum = getHum()
    local hrp = getHRP()
    if not hum or not hrp then return false end

    hum:MoveTo(vec3)

    local startT        = tick()
    local lastPos       = hrp.Position
    local lastMovedT    = tick()

    while tick() - startT < walkTimeout do
        char = getChar()
        hum  = getHum()
        hrp  = getHRP()
        if not (char and hum and hrp) then return false end
        if hum.Health <= 0 then return false end

        local dist = (hrp.Position - vec3).Magnitude
        if dist < 4 then
            hum:MoveTo(hrp.Position) -- ferma il movimento
            return true
        end

        -- controlla se ci stiamo muovendo
        local moved = (hrp.Position - lastPos).Magnitude
        if moved > 0.5 then
            lastMovedT = tick()
            lastPos    = hrp.Position
        else
            -- se siamo fermi da troppo tempo → salta
            if tick() - lastMovedT > stuckTime then
                doJump()
                lastMovedT = tick()   -- reset per evitare spam di salti continui
                lastPos    = hrp.Position
            end
        end

        -- rinnova MoveTo periodicamente (a volte serve dopo un salto)
        hum:MoveTo(vec3)
        task.wait(0.08)
    end

    -- timeout: ferma comunque
    local h2 = getHum()
    local r2 = getHRP()
    if h2 and r2 then h2:MoveTo(r2.Position) end
    return false
end

