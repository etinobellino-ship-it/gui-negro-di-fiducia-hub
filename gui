--========================================================--
-- TEXT FUNCTION
--========================================================--

local function createStyledText(text, size, pos, font)
    local label = Instance.new("TextLabel")

    label.Size = size
    label.Position = pos
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = font
    label.TextTransparency = 1
    label.ZIndex = 10
    label.Parent = container

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 30, 110)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 0, 210)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 0, 255)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 180, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 30, 110))
    })
    gradient.Parent = label

    return label, gradient
end

