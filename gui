local function createPage(name)

    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.fromScale(0.94, 0.92)
    page.Position = UDim2.fromScale(0.03, 0.04)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = COLORS.Purple
    page.Visible = name == currentTab
    page.ZIndex = 115
    page.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.Parent = page

    pages[name] = page

    return page
end

for _, name in ipairs(tabs) do

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromScale(0.88, 0.12)
    button.BackgroundColor3 =
        name == currentTab
        and Color3.fromRGB(45, 25, 65)
        or Color3.fromRGB(22, 22, 32)

    button.BorderSizePixel = 0
    button.Text = name
    button.TextColor3 =
        name == currentTab
        and COLORS.White
        or COLORS.Gray

    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = false
    button.ZIndex = 120
    button.Parent = sidebar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 9)
    corner.Parent = button

    tabButtons[name] = button

    createPage(name)

    button.MouseEnter:Connect(function()

        if currentTab ~= name then

            tween(button, 0.15, {
                BackgroundColor3 =
                    Color3.fromRGB(32, 25, 45)
            })

        end
    end)

    button.MouseLeave:Connect(function()

        if currentTab ~= name then

            tween(button, 0.15, {
                BackgroundColor3 =
                    Color3.fromRGB(22, 22, 32)
            })

        end
    end)

    button.MouseButton1Click:Connect(function()

        if currentTab == name then
            return
        end

        pages[currentTab].Visible = false

        tabButtons[currentTab].BackgroundColor3 =
            Color3.fromRGB(22, 22, 32)

        tabButtons[currentTab].TextColor3 =
            COLORS.Gray

        currentTab = name

        pages[currentTab].Visible = true

        tabButtons[currentTab].BackgroundColor3 =
            Color3.fromRGB(45, 25, 65)

        tabButtons[currentTab].TextColor3 =
            COLORS.White
    end)
end

