local function closeHub()

    local t = Tween(
        hub,
        0.45,
        {
            Size = UDim2.fromScale(0.01, 0.01)
        },
        Enum.EasingStyle.Back,
        Enum.EasingDirection.In
    )

    t.Completed:Wait()

    -- NASCONDE SOLAMENTE L'HUB
    hub.Visible = false

    -- NESSUNO SFONDO VIENE CREATO
    reopen.Visible = true
    reopen.Size = UDim2.fromOffset(0, 0)

    Tween(
        reopen,
        0.45,
        {
            Size = UDim2.fromOffset(58, 58)
        },
        Enum.EasingStyle.Back
    )
end

--========================================================--
-- RIAPRI
--========================================================--

local function openHub()

    Tween(
        reopen,
        0.25,
        {
            Size = UDim2.fromOffset(0, 0)
        },
        Enum.EasingStyle.Back,
        Enum.EasingDirection.In
    )

    task.wait(0.25)

    reopen.Visible = false
    hub.Visible = true
    hub.Size = UDim2.fromScale(0.01, 0.01)

    Tween(
        hub,
        0.65,
        {
            Size = UDim2.fromScale(0.58, 0.62)
        },
        Enum.EasingStyle.Back
    )
end

