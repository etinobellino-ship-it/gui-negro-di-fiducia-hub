--// =========================================================
--// LOADING SEQUENCE
--// =========================================================

local loadingMessages = {
    {0,  "Initializing Negro Hub..."},
    {15, "Checking game environment..."},
    {30, "Loading core modules..."},
    {45, "Preparing interface..."},
    {60, "Loading features..."},
    {75, "Optimizing scripts..."},
    {88, "Almost ready..."},
    {96, "Finalizing..."},
    {100, "Successfully loaded!"}
}

local function updateStatus(value)
    local message = "Loading..."

    for i = #loadingMessages, 1, -1 do
        if value >= loadingMessages[i][1] then
            message = loadingMessages[i][2]
            break
        end
    end

    status.Text = message
end

-- Progress smoothing
for i = 0, 100 do

    percentage.Text = tostring(i) .. "%"

    TweenService:Create(
        progress,
        TweenInfo.new(
            0.12,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromScale(i / 100, 1)
        }
    ):Play()

    updateStatus(i)

    -- Simula un caricamento naturale
    local delayTime

    if i < 20 then
        delayTime = 0.045
    elseif i < 60 then
        delayTime = 0.065
    elseif i < 85 then
        delayTime = 0.085
    else
        delayTime = 0.11
    end

    task.wait(delayTime)
end

